# Development secrets. Copy to .env and change for anything non-local.
POSTGRES_PASSWORD=proview-dev-pg
CLICKHOUSE_PASSWORD=proview-dev-ch
CLICKHOUSE_RO_PASSWORD=proview-dev-ch-ro
# >= 32 characters; shared by banner-service (signing) and event-collector (verification)
TOKEN_SECRET=dev-token-secret-change-me-0123456789abcdef
BANNER_ADMIN_TOKEN=dev-banner-admin-token
ADMIN_PASSWORD=admin
# Image tag when running without --build
PROVIEW_TAG=latest
